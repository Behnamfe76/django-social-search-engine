# Django
# Must be >= 32 bytes: it also signs JWTs (SIMPLE_JWT.SIGNING_KEY defaults to it).
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-generate-a-real-50-char-key-before-running
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=social_search_engine
POSTGRES_USER=social_user
POSTGRES_PASSWORD=social_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_TEST_DB=test_social_search_engine
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=10

# Auth / JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
AUTH_PROTECTED_PREFIXES=/api/
AUTH_EXEMPT_PREFIXES=/api/v1/auth/,/api/v1/health/,/api/schema/,/api/docs/,/api/redoc/,/admin/,/api-auth/

# Redis / Celery
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=660

# Imports
# A chunk is a record-aligned byte range; smaller chunks mean more parallelism
# and more task overhead. IMPORT_SCAN_BLOCK_BYTES bounds the planner's memory.
IMPORT_CHUNK_TARGET_BYTES=1048576
IMPORT_CHUNK_MAX_ROWS=500
IMPORT_SCAN_BLOCK_BYTES=1048576
IMPORT_MAX_UPLOAD_BYTES=2147483648
IMPORT_DELETE_FILE_WHEN_DONE=True

# Docker
# APP_UID/APP_GID matter on Linux only: set them to `id -u` / `id -g` so files
# the container writes into the bind mount stay owned by you.
APP_PORT=8000
APP_UID=1000
APP_GID=1000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
CELERY_CONCURRENCY=4
CELERY_LOGLEVEL=INFO

# Hot reload, for development only. With these on, editing a .py file restarts
# the process that serves it, so no `./sse ctl restart` is needed. Both cost a
# little startup time and memory; leave them off in anything shared.
# GUNICORN_WORKERS=1 pairs well with the reloader.
GUNICORN_RELOAD=false
CELERY_RELOAD=false

# First-run superuser, created by `./sse init` when a password is set here.
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_NAME=Admin
DJANGO_SUPERUSER_PASSWORD=

